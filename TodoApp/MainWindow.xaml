<Window x:Class="TodoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TodoApp.ViewModels"
        x:Name="MainWin"
        Title="Microsoft To Do"
        Width="1100" Height="720"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ContentBgBrush}"
        FontFamily="{StaticResource MainFont}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320"
                               x:Name="DetailColumn">
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDetailPanelOpen}" Value="False">
                                <Setter Property="Width" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!-- ========== LEFT SIDEBAR ========== -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- App title -->
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,12">
                    <TextBlock Text="To Do"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>

                <!-- New list input -->
                <Border DockPanel.Dock="Bottom"
                        Padding="12,8"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding NewListName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AddTaskTextBox}"
                                 BorderThickness="0"
                                 Padding="4,6"
                                 FontSize="13">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddListCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButton}"
                                Command="{Binding AddListCommand}"
                                ToolTip="新建列表"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE710;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="14"
                                       Foreground="{StaticResource PrimaryBlueBrush}" />
                        </Button>
                    </Grid>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource HoverBgBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,0">
                        <!-- Smart lists -->
                        <TextBlock Text="智能列表"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="12,8,0,4" />

                        <ListBox ItemsSource="{Binding SmartLists}"
                                 SelectedItem="{Binding SelectedList}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ItemContainerStyle="{StaticResource SidebarListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding IconGlyph}"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="16"
                                                   Foreground="{StaticResource PrimaryBlueBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TaskCount}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding TaskCount, Converter={StaticResource PositiveCountToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Custom lists -->
                        <TextBlock Text="列表"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="12,16,0,4" />

                        <ListBox ItemsSource="{Binding CustomLists}"
                                 SelectedItem="{Binding SelectedList}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ItemContainerStyle="{StaticResource SidebarListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0"
                                                 Width="10" Height="10"
                                                 Fill="{StaticResource PrimaryBlueBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="4,0,10,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TaskCount}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"
                                                   Visibility="{Binding TaskCount, Converter={StaticResource PositiveCountToVis}}" />
                                        <Button Grid.Column="3"
                                                Padding="2"
                                                Command="{Binding DataContext.DeleteListCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="删除列表"
                                                PreviewMouseLeftButtonDown="DeleteListButton_PreviewMouseLeftButtonDown">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSmartList}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="&#xE74D;"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ========== MAIN CONTENT ========== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="24,20,24,8">
                <TextBlock Text="{Binding HeaderTitle}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding HeaderSubtitle}"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Add task input -->
            <Border Grid.Row="1" Margin="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE710;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="16"
                               Foreground="{StaticResource PrimaryBlueBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0" />
                    <TextBox Grid.Column="1"
                             Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource AddTaskTextBox}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AddTaskCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>
            </Border>

            <!-- Task list -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Active tasks -->
                    <ListBox ItemsSource="{Binding ActiveTasks}"
                             SelectedItem="{Binding SelectedTask, Mode=OneWay}"
                             SelectionChanged="TaskList_SelectionChanged"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemContainerStyle="{StaticResource TaskListItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Complete checkbox -->
                                    <Button Grid.Column="0"
                                            Style="{StaticResource CircleCheckButton}"
                                            Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            PreviewMouseLeftButtonDown="ActionButton_PreviewMouseLeftButtonDown"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0" />

                                    <!-- Task title & steps -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StepProgress, StringFormat='步骤 {0}'}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Visibility="{Binding HasSteps, Converter={StaticResource BoolToVis}}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Due date badge -->
                                    <Border Grid.Column="2"
                                            Background="#F3F2F1"
                                            CornerRadius="10"
                                            Padding="8,3"
                                            Margin="8,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasDueDate, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding DueDateDisplay}"
                                                   FontSize="11"
                                                   Foreground="{Binding Converter={StaticResource DueDateColor}}" />
                                    </Border>

                                    <!-- My Day icon -->
                                    <Button Grid.Column="3"
                                            Style="{StaticResource IconButton}"
                                            Command="{Binding DataContext.ToggleMyDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="添加到我的一天"
                                            PreviewMouseLeftButtonDown="ActionButton_PreviewMouseLeftButtonDown"
                                            VerticalAlignment="Center"
                                            Margin="0,0,2,0">
                                        <TextBlock Text="&#xE706;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#C8C8C8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMyDay}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBlueBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>

                                    <!-- Important star -->
                                    <Button Grid.Column="4"
                                            Style="{StaticResource IconButton}"
                                            Command="{Binding DataContext.ToggleImportantCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="标记为重要"
                                            PreviewMouseLeftButtonDown="ActionButton_PreviewMouseLeftButtonDown"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="&#xE735;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="14"
                                                   Foreground="{Binding IsImportant, Converter={StaticResource ImportantStar}}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Completed section toggle -->
                    <Button Command="{Binding ToggleShowCompletedCommand}"
                            Style="{StaticResource IconButton}"
                            HorizontalAlignment="Left"
                            Margin="16,8"
                            Visibility="{Binding HasCompletedTasks, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70D;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowCompleted}" Value="True">
                                                <Setter Property="Text" Value="&#xE70E;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding CompletedToggleText}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Completed tasks -->
                    <ListBox ItemsSource="{Binding CompletedTasks}"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemContainerStyle="{StaticResource TaskListItem}"
                             Visibility="{Binding ShowCompleted, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Opacity="0.6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource CircleCheckButton}"
                                            Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            PreviewMouseLeftButtonDown="ActionButton_PreviewMouseLeftButtonDown"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               FontSize="14"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextDecorations="Strikethrough"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,60,0,0"
                                Visibility="{Binding ActiveTasks.Count, Converter={StaticResource ZeroCountToVis}}">
                        <TextBlock Text="&#xE8F4;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="48"
                                   Foreground="#C8C8C8"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="尝试添加任务到我的一天"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ========== DETAIL PANEL ========== -->
        <Border Grid.Column="2"
                Background="{StaticResource ContentBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsDetailPanelOpen, Converter={StaticResource BoolToVis}}">
            <DockPanel Margin="20,16">
                <!-- Close button -->
                <Button DockPanel.Dock="Top"
                        Style="{StaticResource IconButton}"
                        Command="{Binding CloseDetailCommand}"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,8"
                        ToolTip="关闭">
                    <TextBlock Text="&#xE711;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedTask}">
                        <!-- Task title -->
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Margin="0,0,0,16"
                                 TextWrapping="Wrap" />

                        <!-- Action buttons row -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Button Style="{StaticResource IconButton}"
                                    Command="{Binding DataContext.ToggleMyDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="添加到我的一天"
                                    Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE706;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="14"
                                               Margin="0,0,4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMyDay}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBlueBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="我的一天"
                                               FontSize="12"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMyDay}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBlueBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource IconButton}"
                                    Command="{Binding DataContext.ToggleImportantCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="标记为重要"
                                    Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE735;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="14"
                                               Foreground="{Binding IsImportant, Converter={StaticResource ImportantStar}}"
                                               Margin="0,0,4,0" />
                                    <TextBlock Text="重要"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Due date section -->
                        <TextBlock Text="截止日期" Style="{StaticResource DetailLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="今天"
                                    Style="{StaticResource IconButton}"
                                    Command="{Binding DataContext.SetDueDateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="today"
                                    FontSize="12"
                                    Margin="0,0,4,0" />
                            <Button Content="明天"
                                    Style="{StaticResource IconButton}"
                                    Command="{Binding DataContext.SetDueDateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="tomorrow"
                                    FontSize="12"
                                    Margin="0,0,4,0" />
                            <Button Content="下周"
                                    Style="{StaticResource IconButton}"
                                    Command="{Binding DataContext.SetDueDateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="nextweek"
                                    FontSize="12"
                                    Margin="0,0,4,0" />
                            <Button Content="清除"
                                    Style="{StaticResource IconButton}"
                                    Command="{Binding DataContext.ClearDueDateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    FontSize="12"
                                    Visibility="{Binding HasDueDate, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <DatePicker SelectedDate="{Binding DueDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="13"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Stretch" />
                        <TextBlock Text="{Binding DueDateDisplay}"
                                   FontSize="13"
                                   Foreground="{Binding Converter={StaticResource DueDateColor}}"
                                   Margin="0,0,0,16"
                                   Visibility="{Binding HasDueDate, Converter={StaticResource BoolToVis}}" />

                        <!-- Steps section -->
                        <TextBlock Text="步骤" Style="{StaticResource DetailLabel}" />
                        <ItemsControl ItemsSource="{Binding Steps}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Style="{StaticResource StepCircleCheckButton}"
                                                Command="{Binding DataContext.ToggleStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource IconButton}"
                                                Padding="2"
                                                Command="{Binding DataContext.DeleteStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE74D;"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="9"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding DataContext.NewStepTitle, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                                     FontSize="13"
                                     Padding="4,6"
                                     BorderThickness="0,0,0,1"
                                     BorderBrush="{StaticResource BorderBrush}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return"
                                                Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1"
                                    Style="{StaticResource IconButton}"
                                    Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <TextBlock Text="&#xE710;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource PrimaryBlueBrush}" />
                            </Button>
                        </Grid>

                        <!-- Notes section -->
                        <TextBlock Text="备注" Style="{StaticResource DetailLabel}" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DetailTextBox}"
                                 Margin="0,0,0,20" />

                        <!-- Delete task -->
                        <Button Content="删除任务"
                                Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#D13438"
                                FontSize="13"
                                Cursor="Hand"
                                HorizontalAlignment="Left"
                                Padding="0,8" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
